# Backend
SPRING_PROFILES_ACTIVE=dev
# Dev can leave JWT_SECRET empty; prod must set a random value of at least 32 bytes.
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost

# Auth security
LOGIN_MAX_FAILURES=5
LOGIN_FAIL_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
AUTO_MIGRATE_LEGACY_PASSWORDS=true

# AI provider
NVIDIA_OPENAI_BASE_URL=https://integrate.api.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODEL=qwen/qwen3.5-397b-a17b
NVIDIA_TEMPERATURE=0.2
NVIDIA_MAX_TOKENS=4096

# Database
MYSQL_URL=jdbc:mysql://localhost:3306/mianshitong?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=xiaozhi
MYSQL_PASSWORD=change-me-db-password

# Docker MySQL root password
MYSQL_ROOT_PASSWORD=change-me-root-password
